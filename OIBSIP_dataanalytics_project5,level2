        "    return spell.correction(word)\n",
        "\n",
        "print(\"Autocorrect Examples:\")\n",
        "print(\"transction ->\", autocorrect(\"transction\"))\n",
        "print(\"frauud ->\", autocorrect(\"frauud\"))\n",
        "print(\"crediit ->\", autocorrect(\"crediit\"))\n",
        "print(\"amunt ->\", autocorrect(\"amunt\"))\n",
        "\n",
        "actual = [\n",
        "    \"transaction\",\n",
        "    \"fraud\",\n",
        "    \"credit\",\n",
        "    \"amount\"\n",
        "]\n",
        "\n",
        "misspelled = [\n",
        "    \"transction\",\n",
        "    \"frauud\",\n",
        "    \"crediit\",\n",
        "    \"amunt\"\n",
        "]\n",
        "\n",
        "correct = 0\n",
        "\n",
        "for i in range(len(actual)):\n",
        "    predicted = autocorrect(misspelled[i])\n",
        "\n",
        "    if predicted == actual[i]:\n",
        "        correct += 1\n",
        "\n",
