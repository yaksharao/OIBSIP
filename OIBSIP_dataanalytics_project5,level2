        "import re\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from collections import Counter\n",
        "\n",
        "# Convert dataset into text corpus\n",
        "text_data = \" \".join(\n",
        "    df.astype(str)\n",
        "      .apply(lambda row: \" \".join(row), axis=1)\n",
        ")\n",
        "\n",
        "# Text Cleaning\n",
        "text_data = text_data.lower()\n",
        "text_data = re.sub(r'[^a-zA-Z\\s]', ' ', text_data)\n",
        "\n",
        "# Tokenization\n",
        "words = text_data.split()\n",
        "\n",
        "print(\"Total Words:\", len(words))\n",
        "\n",
        "# Word Frequency Analysis\n",
        "word_freq = Counter(words)\n",
        "\n",
        "# Create Frequency DataFrame\n",
        "freq_df = pd.DataFrame(\n",
        "    word_freq.most_common(20),\n",
        "    columns=['Word', 'Frequency']\n",
        ")\n",
        "\n",
        "print(\"\\nTop 20 Frequent Words:\")\n",
        "print(freq_df)\n",
        "\n",
        "# Visualization\n",
        "plt.figure(figsize=(12,6))\n",
        "plt.bar(freq_df['Word'], freq_df['Frequency'])\n",
        "plt.xticks(rotation=45)\n",
        "plt.title(\"Top 20 Frequent Words\")\n",
        "plt.xlabel(\"Words\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.show()\n",
        "\n",
        "# Autocomplete Function\n",
        "def autocomplete(prefix, words):\n",
        "    suggestions = []\n",
        "\n",
        "    for word in sorted(set(words)):\n",
        "        if word.startswith(prefix):\n",
        "            suggestions.append(word)\n",
        "\n",
        "    return suggestions[:10]\n",
        "\n",
        "# Test Autocomplete\n",
        "print(\"\\nAutocomplete Results:\")\n",
        "print(\"Prefix 'tr':\", autocomplete('tr', words))\n",
        "print(\"Prefix 'cr':\", autocomplete('cr', words))\n",
        "print(\"Prefix 'fr':\", autocomplete('fr', words))"
